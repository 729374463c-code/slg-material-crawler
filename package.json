{
  "name": "slg-creative-intelligence-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vinext dev",
    "build": "node build/clean-dist.mjs && vinext build && node build/prune-sites-dist.mjs",
    "build:netlify": "vite build --config vite.netlify.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:netlify": "pnpm build:netlify && node --test tests/netlify-static.node-test.mjs",
    "test:sites": "pnpm build && node --test tests/sites-root.node-test.mjs",
    "check": "pnpm test && pnpm test:sites"
  },
  "dependencies": {
    "@carbon/icons-react": "^11.85.0",
    "@carbon/react": "^1.112.0",
    "exceljs": "^4.4.0",
    "next": "16.2.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.0.0",
    "vinext": "0.0.50"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "22.19.19",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "jsdom": "^26.0.0",
    "react-server-dom-webpack": "19.2.6",
    "sass": "^1.80.0",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "vitest": "^3.0.0",
    "wrangler": "4.92.0"
  }
}
